<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_title"
            style="@style/ET.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD PRODUCT" />

        <TextView style="@style/ET.FieldLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Product name *" />
        <EditText android:id="@+id/et_name" style="@style/ET.Input"
            android:hint="e.g. Cooking Oil 2L" android:inputType="textCapWords" />

        <TextView style="@style/ET.FieldLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="SKU / product code *" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText android:id="@+id/et_sku" style="@style/ET.Input"
                android:layout_width="0dp" android:layout_weight="1"
                android:hint="Unique code" android:inputType="textCapCharacters" />
            <TextView android:id="@+id/btn_auto_sku" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:layout_marginLeft="8dp"
                android:background="@drawable/bg_btn_secondary" android:gravity="center"
                android:paddingLeft="14dp" android:paddingRight="14dp" android:text="Auto"
                android:textColor="@color/blue_light" android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/ET.FieldLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Category" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Spinner android:id="@+id/sp_category" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:background="@drawable/bg_spinner" />
            <TextView android:id="@+id/btn_new_category" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:layout_marginLeft="8dp"
                android:background="@drawable/bg_btn_secondary" android:gravity="center"
                android:paddingLeft="14dp" android:paddingRight="14dp" android:text="+ New"
                android:textColor="@color/blue_light" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginRight="6dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/ET.FieldLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Purchase price" />
                <EditText android:id="@+id/et_purchase" style="@style/ET.Input"
                    android:hint="0.00" android:inputType="numberDecimal" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginLeft="6dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/ET.FieldLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Selling price" />
                <EditText android:id="@+id/et_selling" style="@style/ET.Input"
                    android:hint="0.00" android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginRight="6dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/lbl_qty" style="@style/ET.FieldLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Opening quantity" />
                <EditText android:id="@+id/et_qty" style="@style/ET.Input"
                    android:hint="0" android:inputType="number" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginLeft="6dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/ET.FieldLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Minimum stock" />
                <EditText android:id="@+id/et_min" style="@style/ET.Input"
                    android:hint="0" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/tv_qty_note" style="@style/ET.Caption"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:visibility="gone"
            android:text="Quantity changes only through Stock In / Stock Out, so history stays accurate." />

        <TextView style="@style/ET.FieldLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Description (optional)" />
        <EditText android:id="@+id/et_desc" style="@style/ET.Input"
            android:gravity="top" android:hint="Notes about this product"
            android:inputType="textMultiLine|textCapSentences" android:minLines="3"
            android:singleLine="false" />

        <Button android:id="@+id/btn_save" style="@style/ET.Button.Primary"
            android:layout_marginTop="28dp" android:text="Save product" />
        <Button android:id="@+id/btn_cancel" style="@style/ET.Button.Secondary"
            android:layout_marginTop="10dp" android:text="Cancel" />
    </LinearLayout>
</ScrollView>
