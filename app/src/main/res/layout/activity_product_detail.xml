<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/ET.Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Product details"
            android:textColor="@color/green" />

        <TextView android:id="@+id/tv_name" style="@style/ET.Title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:letterSpacing="0" />

        <TextView android:id="@+id/tv_sub" style="@style/ET.Caption"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/bg_hero"
            android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/ET.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Available quantity"
                    android:textColor="@color/ice" />
                <TextView android:id="@+id/tv_qty" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed"
                    android:textColor="#FFFFFF" android:textSize="38sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/tv_status" style="@style/ET.StatusChip" />
        </LinearLayout>

        <LinearLayout style="@style/ET.Card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/ET.Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Purchase price" />
                    <TextView android:id="@+id/tv_purchase" style="@style/ET.Body"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/ET.Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Selling price" />
                    <TextView android:id="@+id/tv_selling" style="@style/ET.Body"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/ET.Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Minimum stock" />
                    <TextView android:id="@+id/tv_min" style="@style/ET.Body"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/ET.Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Stock value (cost)" />
                    <TextView android:id="@+id/tv_value" style="@style/ET.Body"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/ET.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="Date added" />
            <TextView android:id="@+id/tv_date" style="@style/ET.Body"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
            <TextView style="@style/ET.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="Description" />
            <TextView android:id="@+id/tv_desc" style="@style/ET.Body"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_in" style="@style/ET.Button.Primary"
                android:layout_width="0dp" android:layout_marginRight="6dp"
                android:layout_weight="1" android:text="Stock In" />
            <Button android:id="@+id/btn_out" style="@style/ET.Button.Secondary"
                android:layout_width="0dp" android:layout_marginLeft="6dp"
                android:layout_weight="1" android:text="Stock Out" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_edit" style="@style/ET.Button.Secondary"
                android:layout_width="0dp" android:layout_marginRight="6dp"
                android:layout_weight="1" android:text="Edit" />
            <Button android:id="@+id/btn_delete" style="@style/ET.Button.Danger"
                android:layout_width="0dp" android:layout_marginLeft="6dp"
                android:layout_weight="1" android:text="Delete" />
        </LinearLayout>

        <TextView style="@style/ET.Section" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Recent movements" />
        <LinearLayout android:id="@+id/txn_container" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/tv_txn_empty" style="@style/ET.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="No movements recorded for this product yet."
            android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/tv_all_history" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:padding="12dp" android:text="View full history"
            android:textColor="@color/blue_light" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
